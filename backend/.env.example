# Copiá este archivo a ".env" (en la misma carpeta backend/) y completá
# con los valores reales de tu proyecto de Supabase:
# Dashboard de Supabase -> Project Settings -> API

# =============================
# Entorno
# =============================
NODE_ENV=production
PORT=3000

# =============================
# Frontend permitido
# =============================
# Orígenes exactos separados por comas. Ejemplo producción:
ALLOWED_ORIGINS=https://websigtur.onrender.com
FRONTEND_ORIGIN=https://websigtur.onrender.com
FRONTEND_URL=https://websigtur.onrender.com/login.html

# =============================
# Supabase
# =============================
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Privada: solo backend. Nunca usar en JS, HTML o PHP público.
SUPABASE_SERVICE_KEY=tu-service-role-key-aqui
# Solo lectura para el proxy PHP/XAMPP que necesite datos públicos.
SUPABASE_ANON_KEY=tu-anon-key-aqui

# =============================
# OAuth y recuperación
# =============================
# OAuth and recovery return to FRONTEND_URL. Allow this URL in Supabase.
PASSWORD_RESET_REDIRECT_URL=https://websigtur.onrender.com/login.html