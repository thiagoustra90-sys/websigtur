# Copiá este archivo a ".env" (en la misma carpeta backend/) y completá
# con los valores reales de tu proyecto de Supabase:
# Dashboard de Supabase -> Project Settings -> API

NODE_ENV=production
FRONTEND_ORIGIN=https://TU-DOMINIO-PUBLICO

SUPABASE_URL=https://TU-PROYECTO.supabase.co

# OJO: esta es la "service_role" key, NO la "anon" key. Tiene permisos
# totales (bypassea RLS) porque el backend la usa para crear usuarios y
# leer/escribir libremente. Nunca la pongas en código del frontend.
SUPABASE_SERVICE_KEY=tu-service-role-key-aqui
# Clave publishable/anon para el proxy PHP de solo lectura en XAMPP.
SUPABASE_ANON_KEY=tu-anon-key-aqui
SESSION_SECRET=random-string-min-32-chars
ADMIN_ROLES=(admin)
PASSWORD_RESET_REDIRECT_URL=https://TU-DOMINIO-PUBLICO/html/login.php
FRONTEND_URL=https://TU-DOMINIO-PUBLICO/html/login.php
OAUTH_REDIRECT_URL=https://TU-SERVICIO.onrender.com/api/auth/google/callback